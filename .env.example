# PathMaxing configuration. Copy to .env for local runs and never commit .env.
# Every variable is optional in development; production needs the ones marked
# "required in production". Durations use Go syntax: 500ms, 30s, 5m, 168h.

# ---- Server (part 1) --------------------------------------------------------
# development or production. Production means JSON logs, Secure cookies, and
# that BASE_URL must use https.
APP_ENV=development
# Render sets PORT. ADDR, when set, wins over it (for example 127.0.0.1:8080).
PORT=8080
ADDR=
# Public origin of the server: short links are BASE_URL/<code>, and
# state-changing API requests must come from this origin.
BASE_URL=http://localhost:8080
# debug, info, warn or error.
LOG_LEVEL=info
# Built web app to serve under /app/ (web/dist after npm run build).
WEB_DIST_DIR=
# Extra origins allowed to send state-changing requests, comma-separated.
# The Vite dev server needs this.
ALLOWED_ORIGINS=http://localhost:5173
# Reverse proxies in front of the server that append to X-Forwarded-For.
# 0 ignores the header (local runs); Render needs 1.
TRUSTED_PROXY_HOPS=0
# Time allowed for each shutdown stage: HTTP, background workers, cleanup.
SHUTDOWN_TIMEOUT=10s
# At least 32 random characters, for example: openssl rand -hex 32
# Signs password-unlock cookies and keys the daily visitor hash.
# Required in production; without it development uses a random key per run.
SECRET_KEY=

# ---- Database (part 2) ------------------------------------------------------
# Without it the server runs on in-memory defaults and the API is disabled.
# docker compose up -d db gives you this one:
DATABASE_URL=postgres://pathmaxing:pathmaxing@localhost:5432/pathmaxing?sslmode=disable
# Database for the store tests. Each test creates and drops its own schema,
# so it can point at the same database as DATABASE_URL. Unset skips them.
TEST_DATABASE_URL=

# ---- Redirect engine and trust layer (part 3) -------------------------------
# How long a resolved link stays in the in-memory cache, and how many links
# the cache holds.
LINK_CACHE_TTL=60s
LINK_CACHE_SIZE=50000
# Google Safe Browsing API v4 key (non-commercial use). Empty skips the check.
SAFE_BROWSING_API_KEY=
# abuse.ch URLhaus Auth-Key (free account). Empty skips the check.
URLHAUS_AUTH_KEY=
# Path to GeoLite2-Country.mmdb from MaxMind (free account, attribution
# required). Empty stores no country.
GEOLITE2_DB_PATH=
# How often the trust scanner looks for links that are due a re-check, and
# how many destinations it checks at once.
TRUST_SCAN_INTERVAL=30s
TRUST_SCAN_CONCURRENCY=4

# ---- Data, API and governance (part 4) --------------------------------------
# Admin account created (or promoted) at startup. Both empty: no admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# How long a login session lasts.
SESSION_TTL=168h
# Click events wait in a bounded queue and are written in batches of up to
# CLICK_BATCH_SIZE rows, at least every CLICK_FLUSH_INTERVAL. When the queue
# is full, new events are dropped and counted rather than slowing redirects.
CLICK_QUEUE_SIZE=10000
CLICK_BATCH_SIZE=500
CLICK_FLUSH_INTERVAL=1s
